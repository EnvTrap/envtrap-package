{
  "name": "envtrap",
  "version": "3.0.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnvTrap/envtrap-package.git"
  },
  "description": "Zero-Configuration Runtime Secret Leak Detector for Node.js 18+",
  "main": "dist/cli/index.js",
  "bin": {
    "envtrap": "dist/cli/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-hooks.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli/index.js",
    "pretest": "pnpm run build",
    "pretest:coverage": "pnpm run build",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:coverage": "node --test --experimental-test-coverage test/**/*.test.js",
    "postinstall": ""
  },
  "keywords": [
    "security",
    "secrets",
    "env",
    "leak",
    "detector",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "4.1.2",
    "commander": "11.1.0",
    "dotenv": "16.3.1",
    "node-forge": "1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
